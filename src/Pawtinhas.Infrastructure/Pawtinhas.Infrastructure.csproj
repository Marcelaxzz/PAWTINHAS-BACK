<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pawtinhas.Domain\Pawtinhas.Domain.csproj" />
    <ProjectReference Include="..\Pawtinhas.Application\Pawtinhas.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PasswordHasher (Identity), IHostEnvironment e serviços em segundo plano. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- Corrige GHSA-473q-m89c-ghf8 (senha exposta a MITM no TLS sem configuração), presente até a 2.6.0. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- O MailKit traz a 10.0.0, com GHSA-2fmv-rv2c-59x7 e GHSA-846f-f764-76mx; a 10.0.13 corrige. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Relatorios\logo-horizontal.png" />
  </ItemGroup>

</Project>
