<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Segredos de desenvolvimento ficam fora do repositório: dotnet user-secrets (veja o README). -->
    <UserSecretsId>pawtinhas-api-9b1f2c7e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pawtinhas.Application\Pawtinhas.Application.csproj" />
    <ProjectReference Include="..\Pawtinhas.Infrastructure\Pawtinhas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Seed\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
