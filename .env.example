# Copie para ".env" e preencha. O ".env" nunca vai para o repositório (.gitignore).

# MySQL do docker-compose
MYSQL_ROOT_PASSWORD=Root12345
MYSQL_DATABASE=pawtinhas
MYSQL_USER=pawtinhas
MYSQL_PASSWORD=Paw12345

# Chave de assinatura do JWT: 48+ caracteres aleatórios.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_CHAVE=

# Senha de app do Gmail de pawtinhas04@gmail.com (16 letras, sem espaços).
# Gere em https://myaccount.google.com/apppasswords (exige verificação em duas etapas na conta Google).
EMAIL_SENHA_APP=

# Chave do alarme ESP32 (cabeçalho X-Device-Key). Vazia desliga a integração.
DISPOSITIVO_CHAVE=
